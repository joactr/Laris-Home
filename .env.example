# OBLIGATORIAS: sin estas el stack no arranca (compose falla con mensaje claro).
POSTGRES_PASSWORD=cambia_esta_contrasena
JWT_SECRET=cambia_este_secreto_largo_y_aleatorio

# Solo para ejecución local fuera de compose (p. ej. `npm run dev` en server/).
# Dentro de compose DATABASE_URL se construye automáticamente con POSTGRES_PASSWORD.
DATABASE_URL=postgres://larishome:TU_PASSWORD@localhost:5432/larishome

# Opcional (default 7d). Formato de `jsonwebtoken`: "7d", "12h", "3600".
JWT_TTL=7d

# --- Server ---
PORT=4000

# --- AI (opcional; sin clave se desactivan las funciones de IA) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-3.5-turbo
VOICE_RECIPE_DB_LIMIT=10
VOICE_RECIPE_SUGGESTION_LIMIT=3

# --- Push Notifications (opcional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:tu_email@example.com

# --- Voice Assistant Deepgram (opcional) ---
DEEPGRAM_API_KEY=
DEEPGRAM_LANGUAGE=en
DEEPGRAM_ENDPOINTING=2000

# --- CORS: vacío = mismo origen (recomendado con nginx). ---
# Para separar front/back en dominios distintos, lista separada por comas.
CORS_ORIGIN=

# --- Automated Postgres Backups ---
# El backup usa POSTGRES_PASSWORD (compose lo inyecta como PGPASSWORD).
DB_BACKUP_DATABASE=larishome
DB_BACKUP_USER=larishome
# Override legacy (hoy el backup usa POSTGRES_PASSWORD como PGPASSWORD).
DB_BACKUP_PASSWORD=
DB_BACKUP_INTERVAL_SECONDS=86400
DB_BACKUP_RETENTION_DAYS=7

# PELIGRO: solo para demo local. Borra datos. NO usar en prod.
ALLOW_PROD_SEED=

# --- Límites de fetch saliente (opcional) ---
OUTBOUND_FETCH_MAX_BYTES=2097152
OUTBOUND_FETCH_TIMEOUT_MS=15000

# --- Caché del dashboard (opcional, ms) ---
DASHBOARD_CACHE_TTL_MS=30000

# --- Embeddings: vacío = local con transformers.js, `mock` = vectores falsos (tests) ---
EMBEDDINGS_PROVIDER=
